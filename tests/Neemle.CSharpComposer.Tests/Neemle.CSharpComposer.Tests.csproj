<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="SyntaxCorpus.json" LogicalName="SyntaxCorpus.json" />
    <EmbeddedResource Include="../../docs/syntax-coverage.json" LogicalName="SyntaxCoverage.json" />
    <EmbeddedResource Include="../../src/**/*.cs" Exclude="../../src/**/bin/**;../../src/**/obj/**" LogicalName="Corpus/src/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="**/*.cs" Exclude="bin/**;obj/**" LogicalName="Corpus/tests/Neemle.CSharpComposer.Tests/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Neemle.CSharpComposer/Neemle.CSharpComposer.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit.core" Version="2.9.2" />
    <PackageReference Include="xunit.assert" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" PrivateAssets="all" />
  </ItemGroup>
</Project>
