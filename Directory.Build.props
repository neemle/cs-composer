<Project>
  <PropertyGroup>
    <LangVersion>11</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory).dev-temp/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory).dev-temp/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
