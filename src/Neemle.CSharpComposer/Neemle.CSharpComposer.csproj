<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Neemle.CSharpComposer</RootNamespace>
    <AssemblyName>Neemle.CSharpComposer</AssemblyName>
    <PackageId>Neemle.CSharpComposer</PackageId>
    <Version>0.6.0</Version>
    <PackageReleaseNotes>Parse-time nesting limit (128) with raw PARSE002 recovery, so parsing never returns a typed tree that rendering rejects; chains of any length stay typed; cancellable parse overloads. Fixes cast, pattern and is-expression parsing, edit indentation and newlines taken from source, and absolute decode-error offsets. CI gates unit and integration coverage at 100%. Known limitations are listed in the README.</PackageReleaseNotes>
    <Description>.NET 10 library for composing, parsing and editing C# source with an immutable DOM, attached comments and stream/byte-array IO; no Roslyn dependency.</Description>
    <PackageProjectUrl>https://github.com/neemle/cs-composer</PackageProjectUrl>
    <RepositoryUrl>https://github.com/neemle/cs-composer.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>csharp;code-generation;dom;parser;source-editing</PackageTags>
    <Authors>Neemle</Authors>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>false</IncludeSymbols>
    <IncludeSource>false</IncludeSource>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>.dll</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
