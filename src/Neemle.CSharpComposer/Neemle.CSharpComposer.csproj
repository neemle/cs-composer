<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Neemle.CSharpComposer</RootNamespace>
    <AssemblyName>Neemle.CSharpComposer</AssemblyName>
    <PackageId>Neemle.CSharpComposer</PackageId>
    <Version>0.7.0</Version>
    <PackageReleaseNotes>Breaking: every render formats the whole document. Parsed source is no longer written back byte for byte (encoding, BOM and the dominant newline are kept; whitespace, indentation and blank lines come from the formatter). Comments belong to nodes and move, survive and are removed with them; parsed multi-line comment text is dedented. Every checked render reads its output back and refuses output that does not mean the model (EMIT001). New RenderOptions.Newline and MaxLineLength; SortUsings also sorts parsed documents; Reformat is obsolete and returns its input (removed in 0.8.0); FORMAT001 is reported for every opaque node. See the README for details and the remaining known limitations.</PackageReleaseNotes>
    <Description>.NET 10 library for composing, parsing and editing C# source with an immutable DOM, attached comments and stream/byte-array IO; no Roslyn dependency.</Description>
    <PackageProjectUrl>https://github.com/neemle/cs-composer</PackageProjectUrl>
    <RepositoryUrl>https://github.com/neemle/cs-composer.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>csharp;code-generation;dom;parser;source-editing</PackageTags>
    <Authors>Neemle</Authors>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>false</IncludeSymbols>
    <IncludeSource>false</IncludeSource>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>.dll</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
