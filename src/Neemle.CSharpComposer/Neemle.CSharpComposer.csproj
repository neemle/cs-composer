<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Neemle.CSharpComposer</RootNamespace>
    <AssemblyName>Neemle.CSharpComposer</AssemblyName>
    <PackageId>Neemle.CSharpComposer</PackageId>
    <Version>0.5.0</Version>
    <PackageReleaseNotes>Expanded typed C# 7.3-15 syntax model with semantic symbol operations, patterns, queries, declarations, directives and structured documentation. Includes parser, validation, formatting and source-editing fixes, plus compiler-backed syntax and composition regressions.</PackageReleaseNotes>
    <Description>.NET 10 library for composing, parsing and editing C# source with an immutable DOM, attached comments and stream/byte-array IO; no Roslyn dependency.</Description>
    <PackageProjectUrl>https://github.com/neemle/cs-composer</PackageProjectUrl>
    <RepositoryUrl>https://github.com/neemle/cs-composer.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>csharp;code-generation;dom;parser;source-editing</PackageTags>
    <Authors>Neemle</Authors>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>false</IncludeSymbols>
    <IncludeSource>false</IncludeSource>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>.dll</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
