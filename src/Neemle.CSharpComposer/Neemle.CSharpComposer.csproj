<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Neemle.CSharpComposer</RootNamespace>
    <AssemblyName>Neemle.CSharpComposer</AssemblyName>
    <PackageId>Neemle.CSharpComposer</PackageId>
    <Version>0.6.1</Version>
    <PackageReleaseNotes>Source-editing fixes: edits keep the source layout around directives, multi-line chains, lambdas, interpolated strings, type headers and brace-less statements; no edit re-binds a dangling else; container and document comments keep their owner. Await in async contexts, constraint edits, invalid embedded statements (CS1023) and leaked internal exceptions are fixed. Remaining known limitations are listed in the README.</PackageReleaseNotes>
    <Description>.NET 10 library for composing, parsing and editing C# source with an immutable DOM, attached comments and stream/byte-array IO; no Roslyn dependency.</Description>
    <PackageProjectUrl>https://github.com/neemle/cs-composer</PackageProjectUrl>
    <RepositoryUrl>https://github.com/neemle/cs-composer.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>csharp;code-generation;dom;parser;source-editing</PackageTags>
    <Authors>Neemle</Authors>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>false</IncludeSymbols>
    <IncludeSource>false</IncludeSource>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>.dll</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
