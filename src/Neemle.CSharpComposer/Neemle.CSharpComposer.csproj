<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Neemle.CSharpComposer</RootNamespace>
    <AssemblyName>Neemle.CSharpComposer</AssemblyName>
    <PackageId>Neemle.CSharpComposer</PackageId>
    <Version>0.1.0</Version>
    <Description>Independent structured C# composition and rendering.</Description>
    <Authors>Neemle</Authors>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
